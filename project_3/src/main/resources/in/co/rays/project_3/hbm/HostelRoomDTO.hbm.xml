<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

    <class name="HostelRoomDTO" table="HOSTEL_ROOM">

        <id name="id" type="java.lang.Long">
            <column name="ID" />
            <generator class="increment" />
        </id>

        <property name="roomNo" type="java.lang.String">
            <column name="ROOM_NO" />
        </property>

        <property name="capacity" type="int">
            <column name="CAPACITY" />
        </property>

        <property name="type" type="java.lang.String">
            <column name="TYPE" />
        </property>

        <property name="washroom" type="java.lang.String">
            <column name="WASHROOM" />
        </property>

        <property name="fees" type="double">
            <column name="FEES" />
        </property>

        <property name="status" type="java.lang.String">
            <column name="STATUS" />
        </property>

        <!-- Audit Fields from BaseDTO -->

        <property name="createdBy" type="java.lang.String" length="50">
            <column name="CREATED_BY" />
        </property>

        <property name="modifiedBy" type="java.lang.String" length="50">
            <column name="MODIFIED_BY" />
        </property>

        <property name="createdDatetime" type="java.sql.Timestamp">
            <column name="CREATED_DATETIME" />
        </property>

        <property name="modifiedDatetime" type="java.sql.Timestamp">
            <column name="MODIFIED_DATETIME" />
        </property>

    </class>

</hibernate-mapping>
